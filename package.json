{
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5109",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5109",
    "test:rules": "esbuild scripts/check-rules.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-rules.cjs && node node_modules/.cache/check-rules.cjs",
    "test:flow": "esbuild scripts/check-flow.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-flow.cjs && node node_modules/.cache/check-flow.cjs",
    "test": "npm run test:rules && npm run test:flow"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2"
  }
}
